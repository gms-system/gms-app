# ============================================================
# GMS — Environment Variables
# ============================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value marked CHANGE_THIS
#   3. Never commit .env to Git — it is already in .gitignore
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────────────
# PostgreSQL database name, user, and password.
# POSTGRES_PASSWORD must match the password inside DATABASE_URL below.
# Avoid these special characters in the password: @ / : # ?
# (they break the connection URL)
POSTGRES_DB=gms_db
POSTGRES_USER=gms_user
POSTGRES_PASSWORD=CHANGE_THIS_DB_PASSWORD

# ── BACKEND ──────────────────────────────────────────────────────────
# Full async database connection string.
# Replace CHANGE_THIS_DB_PASSWORD with the same value as POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+asyncpg://gms_user:CHANGE_THIS_DB_PASSWORD@db:5432/gms_db

# Secret key used to sign JWT tokens.
# Generate a strong one with:  openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_OUTPUT_OF_openssl_rand_hex_32

# JWT settings — safe to leave as-is
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Directory where uploaded files (photos, PDFs) are stored inside the container
UPLOAD_DIR=/app/uploads

# ── HTTPS / CLOUDFLARE TUNNEL ────────────────────────────────────────
# Free HTTPS via Cloudflare Tunnel (no domain purchase needed).
# Steps to get the token:
#   1. Sign up free at https://cloudflare.com
#   2. Dashboard → Zero Trust → Networks → Tunnels → Create tunnel
#   3. Name it "gms-tunnel" → next → copy the token shown
#   4. Set Public Hostname: your-name.cfargotunnel.com → Service: http://nginx:80
#   5. Paste the token below
# Leave empty to skip the tunnel (app still works on http://IP:8080).
CLOUDFLARE_TUNNEL_TOKEN=

# ── CORS ─────────────────────────────────────────────────────────────
# List of allowed origins in JSON format.
# Use your Cloudflare tunnel URL once set up, e.g.:
#   ["https://gms.yourtunnel.cfargotunnel.com"]
# For direct IP access only:
#   ["http://YOUR_SERVER_IP:8080"]
CORS_ORIGINS=["http://YOUR_SERVER_IP:8080"]

# ── FRONTEND ─────────────────────────────────────────────────────────
# API URL baked into the Next.js bundle at build time.
# Keep this as /api — nginx routes /api/* to the backend automatically.
# Only change this if you are running frontend and backend on different servers.
NEXT_PUBLIC_API_URL=/api
