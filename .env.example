# ============================================================
# GMS — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your own values.
# Run:  cp .env.example .env
# ============================================================

# ── Database ────────────────────────────────────────────────
POSTGRES_DB=gms_db
POSTGRES_USER=gms_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD

# ── Backend ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://gms_user:CHANGE_THIS_PASSWORD@db:5432/gms_db
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_DIR=/app/uploads

# ── Site address (HTTPS via Caddy + Let's Encrypt) ──────────────────
# Free hostname that resolves to your server IP — replace dots with dashes.
# Example: IP 139.59.12.34  ->  SITE_ADDRESS=139-59-12-34.sslip.io
# When you later buy a real domain, just set SITE_ADDRESS=app.yourdomain.com
SITE_ADDRESS=localhost

# ── CORS origins (JSON list). Same-origin via proxy needs none, but add
#    your public URL(s) here, e.g. ["https://139-59-12-34.sslip.io"] ─────
CORS_ORIGINS=["http://localhost:8080","http://localhost:3001"]

# ── Frontend ─────────────────────────────────────────────────
# Keep this RELATIVE ("/api"). nginx serves the app and the API on the same
# origin, so it works on localhost, a server IP, or a domain without rebuilds.
NEXT_PUBLIC_API_URL=/api
